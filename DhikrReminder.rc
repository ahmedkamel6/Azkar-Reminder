// DhikrReminder.rc - Windows resource script
#include "src/resource.h"
#include <winres.h>

// Application manifest (handled by MSVC / CMake)
// CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DhikrReminder.exe.manifest"

// Application icons
IDI_APP_ICON          ICON "assets/icons/app.ico"
IDI_APP_ICON_SMALL    ICON "assets/icons/app_small.ico"
IDI_APP_DORMANT_ICON  ICON "assets/icons/app_dormant.ico"
IDI_APP_DORMANT_SMALL ICON "assets/icons/app_dormant_small.ico"
IDI_APP_YELLOW_ICON   ICON "assets/icons/app_yellow.ico"
IDI_APP_YELLOW_SMALL  ICON "assets/icons/app_yellow_small.ico"
IDI_APP_BLUE_ICON     ICON "assets/icons/app_blue.ico"
IDI_APP_BLUE_SMALL    ICON "assets/icons/app_blue_small.ico"
IDI_APP_RED_ICON      ICON "assets/icons/app_red.ico"
IDI_APP_RED_SMALL     ICON "assets/icons/app_red_small.ico"
IDI_APP_SILVER_ICON   ICON "assets/icons/app_silver.ico"
IDI_APP_SILVER_SMALL  ICON "assets/icons/app_silver_small.ico"
IDI_APP_GOLD_ICON     ICON "assets/icons/app_gold.ico"
IDI_APP_GOLD_SMALL    ICON "assets/icons/app_gold_small.ico"

// Embedded static visual assets & data
IDR_LOGO               RCDATA "assets/images/logo.png"
IDR_LOGO_SMALL         RCDATA "assets/images/logo_small.png"
IDR_LOGO_DORMANT       RCDATA "assets/images/logo_dormant.png"
IDR_LOGO_DORMANT_SMALL RCDATA "assets/images/logo_dormant_small.png"
IDR_LOGO_YELLOW        RCDATA "assets/images/logo_yellow.png"
IDR_LOGO_YELLOW_SMALL  RCDATA "assets/images/logo_yellow_small.png"
IDR_LOGO_BLUE          RCDATA "assets/images/logo_blue.png"
IDR_LOGO_BLUE_SMALL    RCDATA "assets/images/logo_blue_small.png"
IDR_LOGO_RED           RCDATA "assets/images/logo_red.png"
IDR_LOGO_RED_SMALL     RCDATA "assets/images/logo_red_small.png"
IDR_LOGO_SILVER        RCDATA "assets/images/logo_silver.png"
IDR_LOGO_SILVER_SMALL  RCDATA "assets/images/logo_silver_small.png"
IDR_LOGO_GOLD          RCDATA "assets/images/logo_gold.png"
IDR_LOGO_GOLD_SMALL    RCDATA "assets/images/logo_gold_small.png"
IDR_CONTENT_MD         RCDATA "assets/content.md"
IDR_FONT_CAIRO         RCDATA "assets/fonts/cairo.ttf"
IDR_QR_VODAFONE        RCDATA "assets/images/qr_vodafone.png"
IDR_QR_IBAN            RCDATA "assets/images/qr_iban.png"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,2,5,0
PRODUCTVERSION 1,2,5,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "Ahmed Mohamed Kamel"
            VALUE "FileDescription", "Azkar Reminder"
            VALUE "FileVersion",     "1.2.5.0"
            VALUE "InternalName",    "AzkarReminder"
            VALUE "LegalCopyright",  "Copyright © 2026 Ahmed Mohamed Kamel"
            VALUE "OriginalFilename","AzkarReminder.exe"
            VALUE "ProductName",     "Azkar Reminder"
            VALUE "ProductVersion",  "1.2.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Onboarding dialog
IDD_ONBOARDING DIALOGEX 0, 0, 340, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Azkar Reminder - Setup"
FONT 10, "Noto Sans", 400, 0, 0x1
BEGIN
    LTEXT       "", IDC_ONBOARD_TITLE, 20, 14, 300, 18, SS_NOPREFIX
    LTEXT       "", IDC_ONBOARD_BODY,  20, 40, 300, 100, SS_NOPREFIX
    LTEXT       "", IDC_ONBOARD_FILE_LABEL, 20, 150, 300, 12
    PUSHBUTTON  "Browse...", IDC_ONBOARD_BROWSE, 20, 165, 70, 14
    PUSHBUTTON  "<- Back",   IDC_ONBOARD_BACK,   200, 196, 60, 14
    DEFPUSHBUTTON "Next ->",  IDC_ONBOARD_NEXT,   268, 196, 60, 14
END
